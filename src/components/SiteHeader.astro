---
const pathname = Astro.url.pathname;
const isBrowse = pathname === '/' || pathname.startsWith('/b/');
const isAbout = pathname.startsWith('/about');
---

<header class="uv-header">
	<a class="uv-logo" href="/" aria-label="Bactiverse">
		<span class="uv-logo__mark">Ba</span><span class="uv-logo__rest">ctiverse</span>
	</a>

	<nav class="uv-nav" aria-label="Primary">
		<div class="uv-nav__links">
			<a class:list={['uv-link', { 'is-active': isBrowse && !isAbout }]} href="/">
				Browse
				<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 14.5 6.5 9l1.4-1.4L12 11.7l4.1-4.1L17.5 9z"/></svg>
			</a>
			<a class:list={['uv-link', { 'is-active': isAbout }]} href="/about">About</a>
			<a class="uv-link" href="/about#safety">Safety</a>
			<a class="uv-link" href="/about">
				Prompts
				<span class="uv-new">NEW</span>
			</a>
		</div>
		<div class="uv-nav__actions">
			<a class="uv-create" href="/about">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
				Create
			</a>
			<a class="uv-join" href="/about#safety">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M12 3 5 7v5c0 4.5 3 7.5 7 8.5 4-1 7-4 7-8.5V7l-7-4Z"/></svg>
				Join the Community
			</a>
		</div>
	</nav>
</header>

<style>
	.uv-header {
		position: sticky;
		top: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		height: 66px;
		padding: 0 1.25rem;
		background: var(--color-bg);
	}

	.uv-logo {
		display: inline-flex;
		align-items: baseline;
		margin-right: 1.5rem;
		color: var(--color-text);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.06em;
		text-decoration: none;
		transform: translateY(1px);
	}

	.uv-logo:hover,
	.uv-logo__mark {
		color: var(--color-text);
	}

	.uv-logo__rest {
		font-weight: 700;
	}

	.uv-nav {
		display: none;
		align-items: center;
		justify-content: space-between;
		flex: 1;
		min-width: 0;
	}

	@media (min-width: 64rem) {
		.uv-nav {
			display: flex;
		}
	}

	.uv-nav__links,
	.uv-nav__actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	@media (min-width: 80rem) {
		.uv-nav__links,
		.uv-nav__actions {
			gap: 0.65rem;
		}
	}

	.uv-link {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		padding: 0.45rem 0.7rem;
		border-radius: 0.5rem;
		color: var(--color-text-secondary);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		text-decoration: none;
		white-space: nowrap;
	}

	.uv-link:hover,
	.uv-link.is-active {
		color: var(--color-text);
		background: var(--color-hover);
	}

	.uv-new {
		margin-left: 0.35rem;
		padding: 0.08rem 0.38rem;
		border: 0;
		border-radius: 999px;
		background: #ff1f2d;
		color: #fff;
		font-size: 0.625rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		line-height: 1.4;
	}

	.uv-create,
	.uv-join {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		height: 42px;
		padding: 0 1rem;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	.uv-create {
		color: var(--color-on-accent);
		background: linear-gradient(135deg, #7c5cff 0%, #c026d3 100%);
	}

	.uv-create:hover {
		color: var(--color-on-accent);
		filter: brightness(1.08);
	}

	.uv-join {
		color: var(--color-text);
		background: var(--color-join);
	}

	.uv-join:hover {
		color: var(--color-text);
		background: var(--color-join-hover);
	}

	.uv-link:focus-visible,
	.uv-logo:focus-visible,
	.uv-create:focus-visible,
	.uv-join:focus-visible {
		outline: 2px solid #818cf8;
		outline-offset: 2px;
	}
</style>
