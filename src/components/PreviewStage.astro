---
/**
 * Large specimen preview. `mediaKind` is `still` in MVP;
 * `loop` / `viewer` reserved for later without redesigning the page.
 */
export interface Props {
	image: string;
	alt: string;
	mediaKind?: 'still' | 'loop' | 'viewer';
}

const { image, alt, mediaKind = 'still' } = Astro.props;
---

<figure class="preview-stage" data-media-kind={mediaKind}>
	<div class="preview-stage__frame">
		{
			mediaKind === 'still' ? (
				<img
					class="preview-stage__media"
					src={image}
					alt={alt}
					width="960"
					height="720"
					loading="eager"
					decoding="async"
				/>
			) : (
				<div class="preview-stage__placeholder" role="img" aria-label={alt}>
					<p class="preview-stage__placeholder-label">
						{mediaKind === 'loop' ? 'Loop preview coming later' : 'Interactive viewer coming later'}
					</p>
				</div>
			)
		}
	</div>
</figure>

<style>
	.preview-stage {
		margin: 0;
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
		min-width: 0;
		min-height: 450px;
		height: 100%;
		background: #121212;
	}

	.preview-stage__frame {
		position: relative;
		display: grid;
		place-items: center;
		flex: 1;
		min-height: 450px;
		padding: 2.5rem 1.5rem;
		background: #121212;
		overflow: hidden;
	}

	.preview-stage__media {
		width: 100%;
		height: 100%;
		max-height: 100%;
		object-fit: contain;
		object-position: center;
	}

	.preview-stage__placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		min-height: 280px;
		padding: var(--space-6);
		color: #a1a1aa;
		font-size: var(--text-sm);
		text-align: center;
	}

	.preview-stage__placeholder-label {
		margin: 0;
	}

	@media (min-width: 48rem) {
		.preview-stage,
		.preview-stage__frame {
			min-height: 0;
			height: 100%;
		}
	}
</style>
