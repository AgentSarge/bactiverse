---
import SpecimenViewer from './SpecimenViewer';

/**
 * Detail-page preview. Renders a turning 3D colony for the specimen.
 * Browse cards that are not in the live set still use the SVG `image`.
 */
export interface Props {
	shape: 'rod' | 'spherical' | 'spiral' | 'other';
	alt: string;
	slug: string;
}

const { shape, alt, slug } = Astro.props;
---

<figure class="preview-stage">
	<div class="preview-stage__frame">
		<SpecimenViewer client:load shape={shape} slug={slug} label={alt} motion="play" quality="detail" />
	</div>
</figure>

<style>
	.preview-stage {
		margin: 0;
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
		min-width: 0;
		min-height: 450px;
		height: 100%;
		background: #121212;
	}

	.preview-stage__frame {
		position: relative;
		display: flex;
		flex: 1;
		min-height: 450px;
		background: #121212;
		overflow: hidden;
	}

	.preview-stage__frame :global(.specimen-viewer),
	.preview-stage__frame :global(.specimen-viewer canvas) {
		width: 100%;
		height: 100%;
		max-width: 100%;
		display: block;
		overflow: hidden;
	}

	@media (min-width: 48rem) {
		.preview-stage,
		.preview-stage__frame {
			min-height: 0;
			height: 100%;
		}
	}
</style>
