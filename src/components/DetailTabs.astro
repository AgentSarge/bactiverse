---
import type { BacteriaTraits } from '../content.config';

export interface Props {
	prompt: string;
	promptPeek: string;
	traits: BacteriaTraits;
	tags?: string[];
}

const { prompt, promptPeek, traits, tags = [] } = Astro.props;
const factsPeek = `Shape: ${traits.shape}\nHabitat: ${traits.habitat}\nFamous for: ${traits.famousFor}`;
---

<div class="detail-tabs" data-detail-tabs>
	<div class="detail-tabs__list" role="tablist" aria-label="Entry details">
		<button
			type="button"
			class="detail-tabs__tab is-active"
			role="tab"
			id="tab-agent"
			aria-selected="true"
			aria-controls="panel-agent"
			data-tab="agent"
		>
			Agent
		</button>
		<button
			type="button"
			class="detail-tabs__tab"
			role="tab"
			id="tab-prompt"
			aria-selected="false"
			aria-controls="panel-prompt"
			data-tab="prompt"
			tabindex="-1"
		>
			Prompt
		</button>
		<button
			type="button"
			class="detail-tabs__tab"
			role="tab"
			id="tab-facts"
			aria-selected="false"
			aria-controls="panel-facts"
			data-tab="facts"
			tabindex="-1"
		>
			Facts
		</button>
	</div>

	<div
		class="detail-tabs__panel detail-tabs__panel--agent is-active"
		role="tabpanel"
		id="panel-agent"
		aria-labelledby="tab-agent"
		data-panel="agent"
	>
		<div class="detail-agent">
			<div class="detail-agent__header">
				<span class="detail-agent__mark" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
						<path
							d="M12 2.5 13.4 8.2 19 9.6 13.4 11 12 16.7 10.6 11 5 9.6 10.6 8.2 12 2.5Z"
							fill="currentColor"></path>
						<path
							d="M18.2 14.2 18.9 16.5 21.2 17.2 18.9 17.9 18.2 20.2 17.5 17.9 15.2 17.2 17.5 16.5 18.2 14.2Z"
							fill="currentColor"></path>
					</svg>
				</span>
				<h2 class="detail-agent__title">Use with your study agent</h2>
				<p class="detail-agent__lead">Copy the prompt and paste it into your notes or an assistant.</p>
			</div>
			<div class="detail-agent__stage">
				<div class="detail-agent__mask">
					<div class="detail-agent__sheets">
						<article class="detail-agent__sheet detail-agent__sheet--prompt">
							<p class="detail-agent__sheet-label">Prompt</p>
							<pre class="detail-agent__sheet-code">{promptPeek}</pre>
						</article>
						<article class="detail-agent__sheet detail-agent__sheet--facts">
							<p class="detail-agent__sheet-label">Facts</p>
							<pre class="detail-agent__sheet-code">{factsPeek}</pre>
						</article>
					</div>
				</div>
				<div class="detail-agent__action">
					<slot name="copy" />
				</div>
			</div>
		</div>
		<div class="detail-agent__promo" role="note" aria-label="Upsell placeholder">
			<span class="detail-agent__promo-mark" aria-hidden="true">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
					<path
						d="M7 4.5h7.2L19 9.2V19a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 6 19V6A1.5 1.5 0 0 1 7.5 4.5H7Z"
						stroke="currentColor"
						stroke-width="1.6"></path>
					<path d="M14 4.8V9h4.2" stroke="currentColor" stroke-width="1.6"></path>
				</svg>
			</span>
			<span class="detail-agent__promo-copy">
				<strong>Upsell placeholder</strong>
				<span>Placeholder copy for a future upsell CTA.</span>
			</span>
			<svg class="detail-agent__promo-arrow" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
				<path fill="currentColor" d="M13.2 5.2 19 12l-5.8 6.8-1.5-1.3L15.2 13H5v-2h10.2l-3.5-4.5 1.5-1.3Z"></path>
			</svg>
		</div>
	</div>

	<div
		class="detail-tabs__panel"
		role="tabpanel"
		id="panel-prompt"
		aria-labelledby="tab-prompt"
		data-panel="prompt"
		hidden
	>
		<pre class="detail-tabs__code">{prompt}</pre>
	</div>

	<div
		class="detail-tabs__panel"
		role="tabpanel"
		id="panel-facts"
		aria-labelledby="tab-facts"
		data-panel="facts"
		hidden
	>
		<dl class="detail-tabs__facts">
			<div class="detail-tabs__fact">
				<dt>Shape</dt>
				<dd>{traits.shape}</dd>
			</div>
			<div class="detail-tabs__fact">
				<dt>Habitat</dt>
				<dd>{traits.habitat}</dd>
			</div>
			<div class="detail-tabs__fact">
				<dt>Famous for</dt>
				<dd>{traits.famousFor}</dd>
			</div>
		</dl>
		{
			tags.length > 0 && (
				<>
					<h3 class="detail-tabs__heading">Tags</h3>
					<ul class="detail-tabs__tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				</>
			)
		}
	</div>
</div>

<script>
	function initDetailTabs(root: HTMLElement) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

		function activate(name: string) {
			for (const tab of tabs) {
				const selected = tab.dataset.tab === name;
				tab.classList.toggle('is-active', selected);
				tab.setAttribute('aria-selected', selected ? 'true' : 'false');
				tab.tabIndex = selected ? 0 : -1;
			}
			for (const panel of panels) {
				const selected = panel.dataset.panel === name;
				panel.classList.toggle('is-active', selected);
				panel.hidden = !selected;
			}
		}

		root.querySelector('[role="tablist"]')?.addEventListener('click', (event) => {
			const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
			if (!target || !root.contains(target)) return;
			activate(target.dataset.tab ?? 'agent');
		});

		root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
			const key = (event as KeyboardEvent).key;
			const current = document.activeElement as HTMLButtonElement | null;
			if (!current || !tabs.includes(current)) return;

			const index = tabs.indexOf(current);
			let next = index;
			if (key === 'ArrowRight' || key === 'ArrowDown') next = (index + 1) % tabs.length;
			else if (key === 'ArrowLeft' || key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
			else if (key === 'Home') next = 0;
			else if (key === 'End') next = tabs.length - 1;
			else return;

			(event as KeyboardEvent).preventDefault();
			tabs[next]?.focus();
			activate(tabs[next]?.dataset.tab ?? 'agent');
		});
	}

	document.querySelectorAll<HTMLElement>('[data-detail-tabs]').forEach(initDetailTabs);
</script>

<style>
	.detail-tabs {
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
		min-width: 0;
		min-height: 0;
		height: 100%;
		background: #1b1b1f;
		color: #f4f4f5;
	}

	.detail-tabs__list {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-shrink: 0;
		padding: 0.375rem 1.5rem;
		background: #1b1b1f;
	}

	.detail-tabs__tab {
		appearance: none;
		border: 0;
		background: transparent;
		padding: 0.35rem 0;
		color: #a1a1aa;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}

	.detail-tabs__tab:hover,
	.detail-tabs__tab.is-active {
		color: #ffffff;
	}

	.detail-tabs__tab:focus-visible {
		outline: 2px solid #818cf8;
		outline-offset: 3px;
		border-radius: 0.25rem;
	}

	.detail-tabs__panel {
		display: none;
		flex: 1 1 auto;
		min-height: 0;
		overflow: auto;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.detail-tabs__panel.is-active {
		display: flex;
		flex-direction: column;
	}

	.detail-tabs__panel--agent.is-active {
		align-items: stretch;
		justify-content: flex-start;
		gap: 0;
		margin: 0 0.5rem 0.5rem;
		padding: 1.5rem 1.5rem 0.75rem;
		border-radius: 0.75rem;
		background: #141416;
		overflow: hidden;
	}

	.detail-agent {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		min-height: 0;
		width: 100%;
		text-align: center;
	}

	.detail-agent__header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		max-width: 24rem;
	}

	.detail-agent__mark {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-bottom: 0.15rem;
		border-radius: 999px;
		background: #2a2a30;
		color: #e4e4e7;
	}

	.detail-agent__title {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.detail-agent__lead {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.45;
		color: #a1a1aa;
	}

	.detail-agent__stage {
		position: relative;
		width: min(100%, 28rem);
		height: 13rem;
	}

	.detail-agent__mask {
		position: absolute;
		inset: -2rem -3rem 0;
		-webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 92%);
		mask-image: linear-gradient(to bottom, #000 55%, transparent 92%);
		pointer-events: none;
	}

	.detail-agent__sheets {
		position: relative;
		height: 13rem;
		margin: 2rem 3rem 0;
	}

	.detail-agent__sheet {
		position: absolute;
		display: flex;
		flex-direction: column;
		width: 66%;
		height: 11rem;
		overflow: hidden;
		border: 1px solid #3a3a42;
		border-radius: 0.75rem;
		background: #1c1c20;
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
		text-align: left;
	}

	.detail-agent__sheet--prompt {
		top: 0;
		left: 0;
		transform: rotate(-3deg);
	}

	.detail-agent__sheet--facts {
		top: 1.5rem;
		right: 0;
		transform: rotate(2deg);
	}

	.detail-agent__sheet-label {
		margin: 0;
		padding: 0.45rem 0.7rem 0.2rem;
		color: #a1a1aa;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.detail-agent__sheet-code {
		margin: 0;
		padding: 0.15rem 0.7rem 0.7rem;
		overflow: hidden;
		color: #8d8d98;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1.45;
		white-space: pre-wrap;
	}

	.detail-agent__action {
		position: absolute;
		right: 0;
		bottom: 0.25rem;
		left: 0;
		z-index: 1;
		display: flex;
		justify-content: center;
	}

	.detail-agent__promo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: min(100%, 36rem);
		margin: 0.25rem auto 0.5rem;
		padding: 0.5rem 1rem 0.5rem 0.5rem;
		border-radius: 0.7rem;
		background: #1c1c20;
		color: #f4f4f5;
		text-decoration: none;
		text-align: left;
	}

	.detail-agent__promo:hover {
		background: #242428;
		color: #ffffff;
	}

	.detail-agent__promo-mark {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 3rem;
		height: 3rem;
		border-radius: 0.55rem;
		background: #121214;
		color: #c4c4cc;
	}

	.detail-agent__promo-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.detail-agent__promo-copy strong {
		font-size: 0.875rem;
		font-weight: 600;
	}

	.detail-agent__promo-copy span {
		color: #a1a1aa;
		font-size: 0.8125rem;
		line-height: 1.35;
	}

	.detail-agent__promo-arrow {
		flex: 0 0 auto;
		color: #a1a1aa;
	}

	.detail-tabs__code {
		margin: 0;
		width: 100%;
		flex: 1;
		min-height: 12rem;
		padding: 0.9rem 1rem;
		border-radius: 0.75rem;
		background: #121214;
		border: 1px solid #2e2e33;
		color: #d4d4d8;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.55;
		text-align: left;
		white-space: pre-wrap;
		overflow: auto;
	}

	.detail-tabs__heading {
		margin: 1.25rem 0 0;
		font-size: 0.75rem;
		font-family: var(--font-body);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #a1a1aa;
	}

	.detail-tabs__facts {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.detail-tabs__fact dt {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #71717a;
		margin-bottom: 0.2rem;
	}

	.detail-tabs__fact dd {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.45;
		color: #f4f4f5;
	}

	.detail-tabs__tags {
		margin: 0.65rem 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.detail-tabs__tags li {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 0.2rem 0.45rem;
		color: #d4d4d8;
		border: 1px solid #3f3f46;
		border-radius: 0.35rem;
		background: #121214;
	}
</style>
