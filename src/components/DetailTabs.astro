---
import type { BacteriaSource, BacteriaTraits } from '../content.config';

export interface Props {
	description: string;
	traits: BacteriaTraits;
	usefulFor: string[];
	sources: BacteriaSource[];
	tags?: string[];
}

const { description, traits, usefulFor, sources, tags = [] } = Astro.props;
---

<div class="detail-tabs" data-detail-tabs>
	<div class="detail-tabs__list" role="tablist" aria-label="Entry details">
		<button
			type="button"
			class="detail-tabs__tab is-active"
			role="tab"
			id="tab-prompt"
			aria-selected="true"
			aria-controls="panel-prompt"
			data-tab="prompt"
		>
			Prompt
		</button>
		<button
			type="button"
			class="detail-tabs__tab"
			role="tab"
			id="tab-facts"
			aria-selected="false"
			aria-controls="panel-facts"
			data-tab="facts"
			tabindex="-1"
		>
			Facts
		</button>
		<button
			type="button"
			class="detail-tabs__tab"
			role="tab"
			id="tab-sources"
			aria-selected="false"
			aria-controls="panel-sources"
			data-tab="sources"
			tabindex="-1"
		>
			Sources
		</button>
	</div>

	<div
		class="detail-tabs__panel is-active"
		role="tabpanel"
		id="panel-prompt"
		aria-labelledby="tab-prompt"
		data-panel="prompt"
	>
		<p class="detail-tabs__lead">{description}</p>
		<h3 class="detail-tabs__heading">Useful for studying / writing</h3>
		{
			usefulFor.length > 0 ? (
				<ul class="detail-tabs__list-items">
					{usefulFor.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			) : (
				<p class="detail-tabs__muted">General study and plain-language writing about this organism.</p>
			)
		}
		<p class="detail-tabs__note">
			Copy prompt builds a grounded pack with guardrails and an “I’m using this for: ___” blank — study
			and writing help only. See the safety note above for the educational-use limit.
		</p>
	</div>

	<div
		class="detail-tabs__panel"
		role="tabpanel"
		id="panel-facts"
		aria-labelledby="tab-facts"
		data-panel="facts"
		hidden
	>
		<dl class="detail-tabs__facts">
			<div class="detail-tabs__fact">
				<dt>Shape</dt>
				<dd>{traits.shape}</dd>
			</div>
			<div class="detail-tabs__fact">
				<dt>Habitat</dt>
				<dd>{traits.habitat}</dd>
			</div>
			<div class="detail-tabs__fact">
				<dt>Famous for</dt>
				<dd>{traits.famousFor}</dd>
			</div>
		</dl>
		{
			tags.length > 0 && (
				<>
					<h3 class="detail-tabs__heading">Tags</h3>
					<ul class="detail-tabs__tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				</>
			)
		}
	</div>

	<div
		class="detail-tabs__panel"
		role="tabpanel"
		id="panel-sources"
		aria-labelledby="tab-sources"
		data-panel="sources"
		hidden
	>
		{
			sources.length > 0 ? (
				<ul class="detail-tabs__sources">
					{sources.map((source) => (
						<li>
							<a href={source.url} target="_blank" rel="noopener noreferrer">
								{source.title}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="detail-tabs__muted">No sources listed for this entry.</p>
			)
		}
	</div>
</div>

<script>
	function initDetailTabs(root: HTMLElement) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

		function activate(name: string) {
			for (const tab of tabs) {
				const selected = tab.dataset.tab === name;
				tab.classList.toggle('is-active', selected);
				tab.setAttribute('aria-selected', selected ? 'true' : 'false');
				tab.tabIndex = selected ? 0 : -1;
			}
			for (const panel of panels) {
				const selected = panel.dataset.panel === name;
				panel.classList.toggle('is-active', selected);
				panel.hidden = !selected;
			}
		}

		root.querySelector('[role="tablist"]')?.addEventListener('click', (event) => {
			const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
			if (!target || !root.contains(target)) return;
			activate(target.dataset.tab ?? 'prompt');
		});

		root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
			const key = (event as KeyboardEvent).key;
			const current = document.activeElement as HTMLButtonElement | null;
			if (!current || !tabs.includes(current)) return;

			const index = tabs.indexOf(current);
			let next = index;
			if (key === 'ArrowRight' || key === 'ArrowDown') next = (index + 1) % tabs.length;
			else if (key === 'ArrowLeft' || key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
			else if (key === 'Home') next = 0;
			else if (key === 'End') next = tabs.length - 1;
			else return;

			(event as KeyboardEvent).preventDefault();
			tabs[next]?.focus();
			activate(tabs[next]?.dataset.tab ?? 'prompt');
		});
	}

	document.querySelectorAll<HTMLElement>('[data-detail-tabs]').forEach(initDetailTabs);
</script>

<style>
	.detail-tabs {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		min-width: 0;
	}

	.detail-tabs__list {
		display: flex;
		gap: 0;
		border-bottom: 1px solid var(--color-border);
	}

	.detail-tabs__tab {
		appearance: none;
		border: 0;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;
		background: transparent;
		padding: 0.55rem 0.85rem;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		font-weight: 500;
		cursor: pointer;
		transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
	}

	.detail-tabs__tab:hover {
		color: var(--color-text);
	}

	.detail-tabs__tab:focus-visible {
		outline: 2px solid var(--color-accent-soft);
		outline-offset: 2px;
	}

	.detail-tabs__tab.is-active {
		color: var(--color-text);
		border-bottom-color: var(--color-accent-soft);
	}

	.detail-tabs__panel {
		display: none;
		flex-direction: column;
		gap: var(--space-3);
	}

	.detail-tabs__panel.is-active {
		display: flex;
		animation: fade-in var(--duration-med) var(--ease-out);
	}

	.detail-tabs__lead {
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}

	.detail-tabs__heading {
		margin: var(--space-2) 0 0;
		font-size: var(--text-sm);
		font-family: var(--font-body);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.detail-tabs__list-items {
		margin: 0;
		padding-left: 1.15rem;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		color: var(--color-text);
	}

	.detail-tabs__note {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.detail-tabs__muted {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.detail-tabs__facts {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.detail-tabs__fact dt {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-faint);
		margin-bottom: var(--space-1);
	}

	.detail-tabs__fact dd {
		margin: 0;
		font-size: var(--text-base);
		color: var(--color-text);
	}

	.detail-tabs__tags {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.detail-tabs__tags li {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		padding: var(--space-1) var(--space-2);
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
	}

	.detail-tabs__sources {
		margin: 0;
		padding-left: 1.15rem;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.detail-tabs__sources a {
		font-size: var(--text-sm);
		word-break: break-word;
	}
</style>
