---
interface Props {
	placeholder?: string;
	value?: string;
}

const { placeholder = 'Search names…', value = '' } = Astro.props;
---

<div class="search-filter" data-search-filter>
	<label class="search-filter__label" for="browse-search">
		<span class="sr-only">Search bacteria by common or scientific name</span>
	</label>
	<div class="search-filter__field">
		<input
			id="browse-search"
			class="search-filter__input"
			type="search"
			name="q"
			placeholder={placeholder}
			value={value}
			autocomplete="off"
			spellcheck="false"
			data-search-input
		/>
		<svg class="search-filter__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-4.3-4.3m1.8-5.2a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"></path>
		</svg>
	</div>
</div>

<style>
	.search-filter {
		position: relative;
		flex: 1 1 auto;
		width: 100%;
		max-width: 250px;
		margin-left: 0.5rem;
	}

	.search-filter__field {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.search-filter__input {
		width: 100%;
		height: 36px;
		padding: 0.25rem 2.25rem 0.25rem 0.75rem;
		border: 2px solid var(--color-input-border);
		border-radius: 0.375rem;
		background: var(--color-input-bg);
		color: var(--color-text);
		font-size: 0.875rem;
	}

	.search-filter__icon {
		position: absolute;
		right: 0.75rem;
		top: 50%;
		width: 20px;
		height: 20px;
		color: var(--color-icon);
		transform: translateY(-50%);
		pointer-events: none;
	}

	.search-filter__input::placeholder {
		color: var(--color-placeholder);
	}

	.search-filter__input:hover {
		border-color: var(--color-input-border-hover);
	}

	.search-filter__input:focus-visible {
		outline: none;
	}
</style>

<script>
	import {
		matchesFilters,
		parseBrowseCategory,
		type FilterableEntry,
	} from '../lib/filters';

	function readEntry(card: HTMLElement): FilterableEntry {
		return {
			commonName: card.dataset.commonName ?? '',
			scientificName: card.dataset.scientificName ?? '',
			shape: card.dataset.shape ?? '',
			tags: (card.dataset.tags ?? '').split(',').filter(Boolean),
		};
	}

	function syncUrl(category: string, query: string) {
		const url = new URL(window.location.href);
		const cat = parseBrowseCategory(category);
		if (cat === 'all') url.searchParams.delete('category');
		else url.searchParams.set('category', cat);
		const trimmed = query.trim();
		if (!trimmed) url.searchParams.delete('q');
		else url.searchParams.set('q', trimmed);
		window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
	}

	function initBrowseFilters(root: HTMLElement) {
		const input = root.querySelector<HTMLInputElement>('[data-search-input]');
		const cards = [...root.querySelectorAll<HTMLElement>('[data-bacterium-card]')];
		const status = root.querySelector<HTMLElement>('[data-browse-status]');
		const empty = root.querySelector<HTMLElement>('[data-browse-empty]');

		if (!input || cards.length === 0) {
			if (status) status.hidden = true;
			return;
		}

		const category = parseBrowseCategory(root.dataset.category);
		let query = input.value;

		function apply() {
			let visible = 0;
			for (const card of cards) {
				const show = matchesFilters(readEntry(card), { category, query });
				card.hidden = !show;
				if (show) visible += 1;
			}

			if (status) {
				const total = cards.length;
				status.hidden = false;
				if (visible === total && !query.trim() && category === 'all') {
					status.textContent = `${total} specimen${total === 1 ? '' : 's'}`;
				} else {
					status.textContent = `Showing ${visible} of ${total}`;
				}
			}

			if (empty) empty.hidden = visible > 0;
			syncUrl(category, query);
		}

		input.addEventListener('input', () => {
			query = input.value;
			apply();
		});

		apply();
	}

	function boot() {
		for (const root of document.querySelectorAll<HTMLElement>('[data-browse-root]')) {
			initBrowseFilters(root);
		}
	}

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
